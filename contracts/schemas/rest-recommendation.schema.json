{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestRecommendationContracts",
  "$defs": {
    "fatigueType": {
      "type": "string",
      "enum": [
        "physical",
        "sensory_overload",
        "cognitive_overload",
        "emotional_social",
        "bedtime_arousal",
        "unknown"
      ]
    },
    "userPreference": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "quiet",
        "move",
        "surprise",
        null
      ]
    },
    "RestRecommendationRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "session_id",
        "content_version",
        "fatigue_type",
        "available_minutes",
        "source"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "fatigue_type": {
          "$ref": "#/$defs/fatigueType"
        },
        "user_preference": {
          "$ref": "#/$defs/userPreference"
        },
        "available_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "location_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_quest_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_quest_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ManualRestDecisionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured_at",
        "platform",
        "user_provided_context_label",
        "daily_app_usage_minutes",
        "continuous_app_usage_minutes",
        "continuous_usage_is_estimated",
        "app_switches_last_10_minutes",
        "minutes_since_last_rest",
        "local_hour",
        "raw_app_names_included",
        "full_url_included",
        "page_title_included",
        "learning_eligible"
      ],
      "properties": {
        "measured_at": {
          "type": "string",
          "format": "date-time"
        },
        "platform": {
          "type": "string",
          "enum": ["ios", "ipados", "macos"]
        },
        "user_provided_context_label": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 80
        },
        "daily_app_usage_minutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 1440
        },
        "continuous_app_usage_minutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 1440
        },
        "continuous_usage_is_estimated": {
          "type": ["boolean", "null"]
        },
        "app_switches_last_10_minutes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "minutes_since_last_rest": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "local_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "raw_app_names_included": {
          "const": false
        },
        "full_url_included": {
          "const": false
        },
        "page_title_included": {
          "const": false
        },
        "learning_eligible": {
          "const": false
        }
      }
    },
    "RestRecommendationRequestV1_1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "session_id",
        "fatigue_type",
        "available_minutes",
        "source"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "fatigue_type": {
          "$ref": "#/$defs/fatigueType"
        },
        "user_preference": {
          "$ref": "#/$defs/userPreference"
        },
        "available_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "location_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_context": {
          "$ref": "#/$defs/ManualRestDecisionContext"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": { "const": "settings_agent_test_ios" }
            },
            "required": ["source"]
          },
          "then": {
            "required": ["decision_context"],
            "properties": {
              "decision_context": {
                "type": "object",
                "properties": {
                  "platform": { "enum": ["ios", "ipados"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": { "const": "settings_agent_test_macos" }
            },
            "required": ["source"]
          },
          "then": {
            "required": ["decision_context"],
            "properties": {
              "decision_context": {
                "type": "object",
                "properties": {
                  "platform": { "const": "macos" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "not": {
                  "enum": [
                    "settings_agent_test_ios",
                    "settings_agent_test_macos"
                  ]
                }
              }
            },
            "required": ["source"]
          },
          "then": {
            "not": {
              "required": ["decision_context"]
            }
          }
        }
      ]
    },
    "RestRecommendationRequest": {
      "oneOf": [
        {
          "$ref": "#/$defs/RestRecommendationRequestV1"
        },
        {
          "$ref": "#/$defs/RestRecommendationRequestV1_1"
        }
      ]
    },
    "RestQuestRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "content_version",
        "quest_id",
        "reason_code"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "quest_id": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "fallback_quest_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DynamicRestTaskRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "message",
        "generated_task",
        "default_quest_id",
        "actions"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "generated_task": {
          "$ref": "./rest-suggestion.schema.json#/$defs/generatedRestTask"
        },
        "default_quest_id": {
          "type": "null",
          "deprecated": true,
          "description": "Deprecated compatibility field. Contract 1.1 always returns null."
        },
        "actions": {
          "type": "array",
          "prefixItems": [
            {
              "const": "start_rest_session"
            },
            {
              "const": "remind_later"
            },
            {
              "const": "dismiss"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "RestRecommendation": {
      "oneOf": [
        {
          "$ref": "#/$defs/RestQuestRecommendation"
        },
        {
          "$ref": "#/$defs/DynamicRestTaskRecommendation"
        }
      ]
    }
  }
}
