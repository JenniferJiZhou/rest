{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnifiedInboxItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "provider",
    "account_id",
    "conversation_id",
    "provider_message_id",
    "sender",
    "recipients",
    "subject",
    "content",
    "received_at",
    "coverage",
    "summary",
    "important_points",
    "todos",
    "priority",
    "needs_reply",
    "draft_id",
    "sync_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": ["feishu", "dingtalk", "outlook", "qq_mail"]
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "provider_message_id": {
      "type": "string",
      "minLength": 1
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subject": {
      "type": ["string", "null"]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "complete", "note"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["official_api", "imap", "browser_fallback"]
        },
        "complete": {
          "type": "boolean"
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "summary": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4000
    },
    "important_points": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "todos": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "priority": {
      "type": "string",
      "enum": ["urgent", "normal", "low", "uncertain"]
    },
    "needs_reply": {
      "type": ["boolean", "null"]
    },
    "draft_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "sync_status": {
      "type": "string",
      "enum": ["pending", "ready", "failed"]
    }
  }
}
