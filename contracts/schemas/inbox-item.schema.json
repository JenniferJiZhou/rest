{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnifiedInboxItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "provider",
    "account_id",
    "conversation_id",
    "conversation_type",
    "conversation_name",
    "provider_message_id",
    "sender",
    "sender_ref",
    "recipients",
    "subject",
    "content",
    "received_at",
    "coverage",
    "item_kind",
    "revision",
    "message_count",
    "window_started_at",
    "window_ended_at",
    "sealed_at",
    "acknowledged_at",
    "summary",
    "important_points",
    "todos",
    "priority",
    "needs_reply",
    "reply_targets",
    "draft_id",
    "sync_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": ["feishu", "dingtalk", "outlook", "qq_mail"]
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "conversation_type": {
      "type": "string",
      "enum": ["direct", "group"]
    },
    "conversation_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "provider_message_id": {
      "type": "string",
      "minLength": 1
    },
    "sender": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120
    },
    "sender_ref": {
      "type": ["string", "null"],
      "pattern": "^participant_[a-zA-Z0-9_-]{8,64}$"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subject": {
      "type": ["string", "null"]
    },
    "content": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "complete", "note"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["official_api", "imap", "browser_fallback"]
        },
        "complete": {
          "type": "boolean"
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "item_kind": {
      "type": "string",
      "enum": ["message", "conversation_digest"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "message_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "window_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "window_ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "sealed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "acknowledged_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "summary": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4000
    },
    "important_points": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "todos": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "priority": {
      "type": "string",
      "enum": ["urgent", "normal", "low", "uncertain"]
    },
    "needs_reply": {
      "type": ["boolean", "null"]
    },
    "reply_targets": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/InboxReplyTarget"
      }
    },
    "draft_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "sync_status": {
      "type": "string",
      "enum": ["pending", "ready", "failed"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "conversation_type": { "const": "group" },
          "item_kind": { "const": "conversation_digest" }
        },
        "required": ["conversation_type", "item_kind"]
      },
      "then": {
        "properties": {
          "sender": { "type": "null" },
          "sender_ref": { "type": "null" },
          "content": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "InboxReplyTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "display_name", "reason"],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^participant_[a-zA-Z0-9_-]{8,64}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
