{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InboxAcknowledgeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "expected_revision"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
