{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hush.local/contracts/unified-inbox.schema.json",
  "title": "Unified Inbox Contracts",
  "$defs": {
    "Source": {
      "type": "string",
      "enum": ["feishu", "dingtalk", "outlook", "qq_mail"]
    },
    "Priority": {
      "type": "string",
      "enum": ["high", "normal", "low", "uncertain"]
    },
    "ItemStatus": {
      "type": "string",
      "enum": ["open", "acknowledged", "drafting", "discarded", "sent"]
    },
    "DraftStatus": {
      "type": "string",
      "enum": ["editing", "confirmed", "sending", "discarded", "sent"]
    },
    "ConfirmationState": {
      "type": "string",
      "enum": ["none", "confirmed", "expired", "invalidated", "consumed"]
    },
    "Participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "address"],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "address": {
          "type": ["string", "null"],
          "maxLength": 320
        }
      }
    },
    "AttachmentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file_name", "media_type", "size_bytes"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "file_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 120 },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 52428800
        }
      }
    },
    "ProviderCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_acknowledge",
        "can_draft_reply",
        "can_send_reply",
        "supports_attachments"
      ],
      "properties": {
        "can_acknowledge": { "type": "boolean" },
        "can_draft_reply": { "type": "boolean" },
        "can_send_reply": { "type": "boolean" },
        "supports_attachments": { "type": "boolean" }
      }
    },
    "ItemSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "conversation_name",
        "sender_display_name",
        "subject",
        "preview",
        "received_at",
        "needs_reply",
        "is_unread",
        "priority",
        "status",
        "draft_id"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "$ref": "#/$defs/Source" },
        "conversation_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sender_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subject": { "type": "string", "maxLength": 240 },
        "preview": { "type": "string", "maxLength": 500 },
        "received_at": { "type": "string", "format": "date-time" },
        "needs_reply": { "type": "boolean" },
        "is_unread": { "type": "boolean" },
        "priority": { "$ref": "#/$defs/Priority" },
        "status": { "$ref": "#/$defs/ItemStatus" },
        "draft_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ItemDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "conversation_name",
        "sender_display_name",
        "subject",
        "preview",
        "received_at",
        "needs_reply",
        "is_unread",
        "priority",
        "status",
        "draft_id",
        "body",
        "participants",
        "attachments",
        "provider_capabilities",
        "acknowledged_at"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "$ref": "#/$defs/Source" },
        "conversation_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sender_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subject": { "type": "string", "maxLength": 240 },
        "preview": { "type": "string", "maxLength": 500 },
        "received_at": { "type": "string", "format": "date-time" },
        "needs_reply": { "type": "boolean" },
        "is_unread": { "type": "boolean" },
        "priority": { "$ref": "#/$defs/Priority" },
        "status": { "$ref": "#/$defs/ItemStatus" },
        "draft_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "body": { "type": "string", "maxLength": 20000 },
        "participants": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/Participant" }
        },
        "attachments": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/AttachmentMetadata" }
        },
        "provider_capabilities": {
          "$ref": "#/$defs/ProviderCapabilities"
        },
        "acknowledged_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "Draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "item_id",
        "body",
        "status",
        "version",
        "updated_at",
        "confirmation_state",
        "sent_at"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "item_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"
        },
        "status": { "$ref": "#/$defs/DraftStatus" },
        "version": { "type": "integer", "minimum": 1 },
        "updated_at": { "type": "string", "format": "date-time" },
        "confirmation_state": { "$ref": "#/$defs/ConfirmationState" },
        "sent_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "Confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation_id",
        "draft_id",
        "item_id",
        "source",
        "draft_version",
        "expires_at"
      ],
      "properties": {
        "confirmation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "draft_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "item_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "$ref": "#/$defs/Source" },
        "draft_version": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "ListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "items", "next_cursor"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ItemSummary" }
        },
        "next_cursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "ItemResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "item"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "item": { "$ref": "#/$defs/ItemDetail" }
      }
    },
    "DraftResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "draft"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "draft": { "$ref": "#/$defs/Draft" }
      }
    },
    "AcknowledgeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 }
      }
    },
    "PatchDraftRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "request_id",
            "operation",
            "expected_version",
            "body"
          ],
          "properties": {
            "schema_version": { "type": "string", "const": "1.0" },
            "request_id": { "type": "string", "minLength": 1 },
            "operation": { "type": "string", "const": "update_body" },
            "expected_version": { "type": "integer", "minimum": 1 },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "request_id",
            "operation",
            "expected_version"
          ],
          "properties": {
            "schema_version": { "type": "string", "const": "1.0" },
            "request_id": { "type": "string", "minLength": 1 },
            "operation": { "type": "string", "const": "discard" },
            "expected_version": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "ConfirmationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "expected_version"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "expected_version": { "type": "integer", "minimum": 1 }
      }
    },
    "ConfirmationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "confirmation"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "confirmation": { "$ref": "#/$defs/Confirmation" }
      }
    },
    "SendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "confirmation_id",
        "expected_version"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "confirmation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expected_version": { "type": "integer", "minimum": 1 }
      }
    },
    "SendResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_id",
        "item_id",
        "status",
        "version",
        "sent_at",
        "delivery_mode"
      ],
      "properties": {
        "draft_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "item_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "const": "sent" },
        "version": { "type": "integer", "minimum": 1 },
        "sent_at": { "type": "string", "format": "date-time" },
        "delivery_mode": { "type": "string", "enum": ["simulated", "real"] }
      }
    },
    "SendResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "result"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "result": { "$ref": "#/$defs/SendResult" }
      }
    }
  }
}
